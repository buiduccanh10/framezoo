generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model bookmarks {
  tmdb_id           String   @db.VarChar(255)
  user_id           String   @db.VarChar(255)
  meta              Json
  updated_at        DateTime @db.Timestamptz(0)
  group             String[]
  favorite_episodes String[] @default([])

  @@id([tmdb_id, user_id])
  @@unique([tmdb_id, user_id], map: "bookmarks_tmdb_id_user_id_unique")
}

model challenge_codes {
  code       String   @id @db.Uuid
  flow       String
  auth_type  String   @db.VarChar(255)
  created_at DateTime @db.Timestamptz(0)
  expires_at DateTime @db.Timestamptz(0)
}

model progress_items {
  id             String   @id @db.Uuid
  tmdb_id        String   @db.VarChar(255)
  user_id        String   @db.VarChar(255)
  season_id      String?  @db.VarChar(255)
  episode_id     String?  @db.VarChar(255)
  meta           Json
  updated_at     DateTime @db.Timestamptz(0)
  duration       BigInt
  watched        BigInt
  season_number  Int?
  episode_number Int?

  @@unique([tmdb_id, user_id, season_id, episode_id], map: "progress_items_tmdb_id_user_id_season_id_episode_id_unique")
}

model sessions {
  id          String   @id @db.Uuid
  user        String
  created_at  DateTime @db.Timestamptz(0)
  accessed_at DateTime @db.Timestamptz(0)
  expires_at  DateTime @db.Timestamptz(0)
  refresh_jti String?  @db.Uuid
  refresh_expires_at DateTime? @db.Timestamptz(0)
  device      String
  user_agent  String
}

model user_group_order {
  id          String   @id @db.Uuid
  user_id     String   @unique(map: "user_group_order_user_id_unique") @db.VarChar(255)
  group_order String[] @default([])
  created_at  DateTime @default(now()) @db.Timestamptz(0)
  updated_at  DateTime @default(now()) @db.Timestamptz(0)
}

model user_settings {
  id                        String   @id
  application_theme         String?  @default("ember") @db.VarChar(255)
  custom_theme              Json?
  application_language      String?  @db.VarChar(255)
  default_subtitle_language String?  @db.VarChar(255)
  enable_autoplay           Boolean  @default(true)
  enable_skip_credits       Boolean  @default(false)
  proxy_tmdb                Boolean  @default(false)
  addons                    Json?    @default("[]")
  native_subtitles_enabled  Boolean  @default(true)
}

model user_provider_credentials {
  id                String   @id @default(uuid()) @db.Uuid
  user_id           String
  provider          String   @db.VarChar(64)
  secret_ciphertext String   @db.Text
  created_at        DateTime @default(now()) @db.Timestamptz(0)
  updated_at        DateTime @updatedAt @db.Timestamptz(0)

  @@unique([user_id, provider], map: "user_provider_credentials_user_id_provider_key")
  @@index([user_id], map: "user_provider_credentials_user_id_idx")
}

model users {
  id             String    @id
  public_key     String
  namespace      String    @db.VarChar(255)
  created_at     DateTime  @db.Timestamptz(0)
  last_logged_in DateTime? @db.Timestamptz(0)
  permissions    String[]
  profile        Json
  ratings        Json      @default("[]")
  nickname       String    @unique @db.VarChar(255)
  email             String?   @unique @db.VarChar(255)
  email_verified_at DateTime? @db.Timestamptz(0)
}

model email_otp_challenges {
  id                String    @id @default(uuid()) @db.Uuid
  purpose           String    @db.VarChar(64)
  user_id           String?
  email             String    @db.VarChar(255)
  payload           Json?
  code_hash         String    @db.VarChar(128)
  expires_at        DateTime  @db.Timestamptz(0)
  attempts          Int       @default(0)
  max_attempts      Int       @default(5)
  last_sent_at      DateTime? @db.Timestamptz(0)
  verified_at       DateTime? @db.Timestamptz(0)
  consumed_at       DateTime? @db.Timestamptz(0)
  action_token_hash String?   @db.VarChar(128)
  action_expires_at DateTime? @db.Timestamptz(0)
  created_at        DateTime  @default(now()) @db.Timestamptz(0)
  request_ip        String?   @db.VarChar(255)

  @@index([email, purpose, created_at])
  @@index([user_id, purpose, created_at])
  @@index([action_token_hash])
}

model email_outbox {
  id                  String    @id @default(uuid()) @db.Uuid
  challenge_id        String?   @db.Uuid
  dedupe_key          String    @unique @db.VarChar(255)
  payload_ciphertext  String    @db.Text
  status              String    @default("pending") @db.VarChar(32)
  attempts            Int       @default(0)
  available_at        DateTime  @default(now()) @db.Timestamptz(0)
  locked_at           DateTime? @db.Timestamptz(0)
  sent_at             DateTime? @db.Timestamptz(0)
  provider_message_id String?   @db.VarChar(512)
  last_error          String?   @db.Text
  created_at          DateTime  @default(now()) @db.Timestamptz(0)
  updated_at          DateTime  @updatedAt @db.Timestamptz(0)

  @@index([status, available_at])
  @@index([challenge_id])
}

model otp_idempotency_keys {
  id             String    @id @default(uuid()) @db.Uuid
  scope          String    @db.VarChar(512)
  key            String    @db.VarChar(128)
  request_hash   String    @db.VarChar(128)
  status         String    @default("processing") @db.VarChar(32)
  response_json  Json?
  expires_at     DateTime  @db.Timestamptz(0)
  created_at     DateTime  @default(now()) @db.Timestamptz(0)
  updated_at     DateTime  @updatedAt @db.Timestamptz(0)

  @@unique([scope, key])
  @@index([expires_at])
}

model watch_history {
  id             String   @id @db.Uuid
  user_id        String   @db.VarChar(255)
  tmdb_id        String   @db.VarChar(255)
  season_id      String?  @db.VarChar(255)
  episode_id     String?  @db.VarChar(255)
  meta           Json
  duration       Float
  watched        Float
  watched_at     DateTime @db.Timestamptz(0)
  completed      Boolean  @default(false)
  season_number  Int?
  episode_number Int?
  updated_at     DateTime @default(now()) @db.Timestamptz(0)

  @@unique([tmdb_id, user_id, season_id, episode_id], map: "watch_history_tmdb_id_user_id_season_id_episode_id_unique")
}

model feedbacks {
  id          String   @id @db.Uuid
  title       String   @db.VarChar(255)
  description String   @db.Text
  status      String   @default("pending") @db.VarChar(50)
  user_id     String?  @db.VarChar(255)
  attachments Json     @default("[]")
  created_at  DateTime @default(now()) @db.Timestamptz(0)
  updated_at  DateTime @default(now()) @db.Timestamptz(0)

  @@index([status], map: "feedbacks_status_idx")
  @@index([created_at(sort: Desc)], map: "feedbacks_created_at_idx")
}

