# ---------- Build Stage ----------
FROM node:20-alpine AS build
ARG VERSION=dev
ARG TMDB_API_KEY
ENV TMDB_API_KEY=${TMDB_API_KEY}
WORKDIR /app

# Install only production dependencies first (leveraging cache)
COPY provider-db-api/package.json provider-db-api/package-lock.json ./
# Using npm install instead of npm ci because lock file appears out-of-sync
# If you later regenerate lock (npm install locally) you can revert to npm ci for reproducibility
RUN npm install --omit=dev

# Copy only required source (avoid sending screenshots, node_modules already installed)
COPY provider-db-api/apiServer.js ./
COPY provider-db-api/providers ./providers
COPY provider-db-api/public ./public
COPY provider-db-api/utils ./utils
COPY provider-db-api/proxy ./proxy
COPY provider-db-api/README.md ./

# ---------- Runtime Stage ----------
FROM node:20-alpine AS runtime
ARG VERSION=dev
ARG TMDB_API_KEY
WORKDIR /app
ENV NODE_ENV=production \
    API_PORT=8787 \
    BIND_HOST=0.0.0.0 \
    APP_VERSION=${VERSION} \
    TMDB_API_KEY=${TMDB_API_KEY}

# Create non-root user
RUN addgroup -S app && adduser -S app -G app

# Copy node_modules from build and necessary source
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apiServer.js ./
COPY --from=build /app/public ./public
COPY --from=build /app/providers ./providers
COPY --from=build /app/utils ./utils
COPY --from=build /app/proxy ./proxy
COPY --from=build /app/package.json ./
COPY --from=build /app/README.md ./

# Expose port
EXPOSE 8787

# Create data directory and ensure permissions
RUN mkdir -p /app/data && chown -R app:app /app/data && chmod 777 /app/data

# Ensure runtime user owns app directory for writes (overrides, restart marker)
RUN chown -R app:app /app
USER app

# Healthcheck (simple)
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD wget -qO- http://localhost:${API_PORT:-8787}/api/health || exit 1

# If volume is empty, copy default config from image
CMD ["sh", "-c", "if [ ! -f /app/data/user-config.json ]; then cp /app/utils/user-config.json /app/data/user-config.json; fi; node apiServer.js"]
