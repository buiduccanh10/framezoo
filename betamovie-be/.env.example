# Database credentials
PG_USER=p-stream_user
# Use a strong password
PG_PASSWORD=password
PG_DB=p-stream_backend
DATABASE_URL="postgresql://${PG_USER}:${PG_PASSWORD}@localhost:5432/${PG_DB}?schema=public"
DATABASE_URL_DOCKER="postgresql://${PG_USER}:${PG_PASSWORD}@postgres:5432/${PG_DB}?schema=public"

# App metadata
META_NAME=''
META_DESCRIPTION=''

# Required: Security secret (generate with `openssl rand -base64 24` or use https://bitwarden.com/password-generator/)
CRYPTO_SECRET='' 
SESSION_COOKIE_NAME='bm_session'
REFRESH_COOKIE_NAME='bm_refresh'
ACCESS_TOKEN_EXPIRY_SECONDS=300
REFRESH_TOKEN_EXPIRY_SECONDS=2592000
INTERNAL_API_TOKEN='' # Required for internal server-to-server API calls (preview-service -> backend /api/*)
SEED_ADMIN_ID='' # Required for prisma seed
SEED_ADMIN_PASSPHRASE='' # Required for prisma seed
SEED_ADMIN_NICKNAME='Admin' # Optional: overrides the existing admin nickname during seed
SEED_ADMIN_NAMESPACE='movie-web' # Optional: overrides the existing admin namespace during seed

# CORS (comma-separated list of allowed frontend origins)
# Examples:
# - local dev: http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# - production: https://app.betamovie.com
CORS_ALLOWED_ORIGINS='http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174'
# Backward-compatible single origin (used only when CORS_ALLOWED_ORIGINS is empty)
FRONTEND_ORIGIN='http://localhost:5173'

# API Keys
# From https://www.themoviedb.org/settings/api
TMDB_API_KEY=''
TIDB_API_KEY='' # Optional: used for Authorization Bearer when calling api.theintrodb.org
# TMDB cache TTLs (seconds)
# - Most metadata endpoints: long cache (default 30 days)
TMDB_PROXY_METADATA_CACHE_TTL=2592000
# - Detail endpoints (movie/{id}, tv/{id}, season/episode details): short cache (default 1 hour)
TMDB_PROXY_DETAIL_CACHE_TTL=3600
# TMDB crawler catalog cache TTL: default 30 days
TMDB_CATALOG_CACHE_TTL=2592000
SUBSOURCE_API_KEY=''

# Optional: Stream providers
VIXSRC_BASE_URL='https://vixsrc.to'
VIDLINK_BASE_URL='https://vidlink.pro'
VIDLINK_BOOT_WAIT_MS=500
VIDSRCTO_BASE_URL='https://vidsrc.to'
# Segment retry/fallback tuning for /api/m3u8-proxy
M3U8_SEGMENT_RETRY_ATTEMPTS=2
M3U8_ENABLE_720_SEGMENT_FALLBACK=true
M3U8_FALLBACK_STICKY_SECONDS=30

# Optional: Captcha
CAPTCHA=false
CAPTCHA_CLIENT_KEY=''

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
# RATE_LIMIT_WINDOW_MS: The time window in milliseconds (default: 60000 / 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS: The maximum number of requests allowed per client IP within the time window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

