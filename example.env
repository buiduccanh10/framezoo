# Frontend
VITE_PWA_ENABLED=false
VITE_OPENSEARCH_ENABLED=false

# Make sure proxy URLs do NOT have a slash at the end.
VITE_CORS_PROXY_URL=
VITE_M3U8_PROXY_URL=

# Make sure the domain does NOT have a slash at the end.
VITE_APP_DOMAIN=http://localhost:5173


# Backend URL(s) - can be a single URL or comma-separated list.
VITE_BACKEND_URL=http://localhost:3000

# Desktop addon authoring guide URL.
VITE_ADDON_GUIDE_URL=http://localhost:5173/#addon-guide

# Optional desktop app download links.
# Use APP_DOWNLOAD_BASE_URL for a shared folder containing the packaged desktop files
# (DMG/ZIP), or set the per-arch URLs below.
APP_DOWNLOAD_BASE_URL=
APP_DOWNLOAD_MAC_ARM64_URL=
APP_DOWNLOAD_MAC_X64_URL=
APP_DOWNLOAD_MAC_UNIVERSAL_URL=

# Public client-side API keys.
VITE_TIDB_API_KEY=

# Set to "false" to allow DevTools in production.
VITE_ENABLE_DEVTOOLS_PROTECTION=false

# Backend
PG_USER=framezoo
PG_PASSWORD=change-me
PG_DB=framezoo_backend
DATABASE_URL="postgresql://${PG_USER}:${PG_PASSWORD}@localhost:5432/${PG_DB}?schema=public"
DATABASE_URL_DOCKER="postgresql://${PG_USER}:${PG_PASSWORD}@postgres:5432/${PG_DB}?schema=public"

META_NAME='Framezoo'
META_DESCRIPTION=''

CRYPTO_SECRET=''
# Optional separate secret for hashing email OTPs. Falls back to CRYPTO_SECRET when empty.
OTP_SECRET=''
# Optional separate key for encrypting queued OTP payloads. Falls back to OTP_SECRET/CRYPTO_SECRET.
EMAIL_OUTBOX_SECRET=''
SESSION_COOKIE_NAME='fz_session'
REFRESH_COOKIE_NAME='fz_refresh'
ACCESS_TOKEN_EXPIRY_SECONDS=300
REFRESH_TOKEN_EXPIRY_SECONDS=2592000
INTERNAL_API_TOKEN=''
# CORS
CORS_ALLOWED_ORIGINS='http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,app://renderer'
FRONTEND_ORIGIN='http://localhost:5173'

# Transactional email worker
SMTP_HOST='smtp.example.com'
SMTP_PORT=587
SMTP_USER=''
SMTP_PASS=''
MAIL_FROM='Framezoo <noreply@framezoo.top>'
EMAIL_WORKER_CONCURRENCY=5

# API Keys
TMDB_API_KEY=''
TIDB_API_KEY=''
OMDB_API_KEY=''
TMDB_PROXY_METADATA_CACHE_TTL=2592000
TMDB_PROXY_DETAIL_CACHE_TTL=3600
TMDB_CATALOG_CACHE_TTL=2592000
WYZIE_API_KEY=''
SUBSOURCE_API_KEY=''
OPENSUBTITLES_API_KEY=''

# Cloudflare Workers AI Search Gateway
AI_GATEWAY_URL=''
AI_GATEWAY_SECRET=''
RATE_LIMIT_AI_SEARCH_WINDOW_MS=60000
RATE_LIMIT_AI_SEARCH_MAX_REQUESTS=15

# Optional captcha
CAPTCHA=false
CAPTCHA_CLIENT_KEY=''

# Use redis://localhost:6379 outside Docker, redis://redis:6379 inside Docker.
REDIS_URL=redis://redis:6379
REDIS_QUEUE_URL=redis://redis-queue:6379

# OTP abuse controls
OTP_COOLDOWN_MAX_REQUESTS=1
OTP_COOLDOWN_WINDOW_MS=60000
OTP_EMAIL_MAX_REQUESTS=5
OTP_EMAIL_WINDOW_MS=900000
OTP_IP_MAX_REQUESTS=10
OTP_IP_WINDOW_MS=900000
OTP_USER_MAX_REQUESTS=10
OTP_USER_WINDOW_MS=900000

# Optional frontend runtime flags (framezoo-fe)
VITE_USE_TRAKT=false
VITE_LEGAL_OPERATOR_NAME='Bùi Đức Cảnh (Nhà phát triển độc lập dự án Framezoo)'
VITE_LEGAL_OPERATOR_ADDRESS='Pháo Đài Láng, P. Láng, Thành phố Hà Nội, Việt Nam'
VITE_LEGAL_EMAIL='framezoo.top@gmail.com'
VITE_LEGAL_PHONE='0984908816'
