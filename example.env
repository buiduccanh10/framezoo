# Frontend
VITE_PWA_ENABLED=false
VITE_OPENSEARCH_ENABLED=false

# Make sure proxy URLs do NOT have a slash at the end.
VITE_CORS_PROXY_URL=
VITE_M3U8_PROXY_URL=

# Make sure the domain does NOT have a slash at the end.
VITE_APP_DOMAIN=http://localhost:5173

# Optional Cloudflare cache purge after deploy.
# Token permission: Zone > Cache Purge > Purge
CLOUDFLARE_API_TOKEN=''
CLOUDFLARE_ZONE_ID=''
# Optional override, defaults to VITE_APP_DOMAIN.
CLOUDFLARE_PURGE_DOMAIN=''
# Optional extra absolute URLs, separated by spaces or commas.
CLOUDFLARE_PURGE_EXTRA_URLS=''

# Backend URL(s) - can be a single URL or comma-separated list.
VITE_BACKEND_URL=http://localhost:3000

# Optional desktop app download links.
# Use APP_DOWNLOAD_BASE_URL for a shared folder containing the packaged desktop files
# (DMG/ZIP), or set the per-arch URLs below.
APP_DOWNLOAD_BASE_URL=
APP_DOWNLOAD_MAC_ARM64_URL=
APP_DOWNLOAD_MAC_X64_URL=
APP_DOWNLOAD_MAC_UNIVERSAL_URL=

# Public client-side API keys used for external subtitle lookups.
VITE_TIDB_API_KEY=
VITE_WYZIE_API_KEY=
VITE_SUBSOURCE_API_KEY=

# Set to "false" to allow DevTools in production.
VITE_ENABLE_DEVTOOLS_PROTECTION=false

# Backend
PG_USER=betamovie
PG_PASSWORD=change-me
PG_DB=betamovie_backend
DATABASE_URL="postgresql://${PG_USER}:${PG_PASSWORD}@localhost:5432/${PG_DB}?schema=public"
DATABASE_URL_DOCKER="postgresql://${PG_USER}:${PG_PASSWORD}@postgres:5432/${PG_DB}?schema=public"

META_NAME='AlphaFlix'
META_DESCRIPTION=''

CRYPTO_SECRET=''
SESSION_COOKIE_NAME='bm_session'
REFRESH_COOKIE_NAME='bm_refresh'
ACCESS_TOKEN_EXPIRY_SECONDS=300
REFRESH_TOKEN_EXPIRY_SECONDS=2592000
INTERNAL_API_TOKEN=''
# Required for admin seeding in every environment.
SEED_ADMIN_ID=''
SEED_ADMIN_PASSPHRASE=''

# CORS
CORS_ALLOWED_ORIGINS='http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174'
FRONTEND_ORIGIN='http://localhost:5173'

# API Keys
TMDB_API_KEY=''
TIDB_API_KEY=''
TMDB_PROXY_METADATA_CACHE_TTL=2592000
TMDB_PROXY_DETAIL_CACHE_TTL=3600
TMDB_CATALOG_CACHE_TTL=2592000
SUBSOURCE_API_KEY=''

# Optional stream providers
VIXSRC_BASE_URL='https://vixsrc.to'
VIDLINK_BASE_URL='https://vidlink.pro'
VIDLINK_BOOT_WAIT_MS=500
VIDSRC_BASE_URL='https://vidsrc-embed.ru'
VIDSRC_HOST_URL='https://cloudnestra.com'
VIDSRC_REQUEST_TIMEOUT_MS=12000
VIDSRCWTF_BASE_URL='https://www.vidsrc.wtf'
VIDSRCWTF_API_BASE_URL='https://api.rgshows.ru'
VIDSRCWTF_API_USER_AGENT='curl/8.7.1'
VIDSRCWTF_REQUEST_TIMEOUT_MS=12000
VIDKING_BASE_URL='https://www.vidking.net'
VIDKING_REQUEST_TIMEOUT_MS=18000
M3U8_SEGMENT_RETRY_ATTEMPTS=2
M3U8_ENABLE_720_SEGMENT_FALLBACK=true
M3U8_FALLBACK_STICKY_SECONDS=30

# Optional captcha
CAPTCHA=false
CAPTCHA_CLIENT_KEY=''

# Use redis://localhost:6379 outside Docker, redis://redis:6379 inside Docker.
REDIS_URL=redis://redis:6379

# Optional preview-service tuning
PREVIEW_INTERVAL_SECONDS=10
PREVIEW_FRAME_WIDTH=320
PREVIEW_TILE_COLS=5
PREVIEW_TILE_ROWS=5
PREVIEW_MAX_FRAMES=48
PREVIEW_FFMPEG_CONCURRENCY=4
PREVIEW_COMMAND_TIMEOUT_MS=90000

# Optional frontend runtime flags (betamovie-fe)
VITE_USE_TRAKT=false
