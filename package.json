{
  "name": "betamovie",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --dir betamovie-fe run dev",
    "dev:fe": "pnpm --dir betamovie-fe run dev",
    "dev:be": "pnpm --dir betamovie-be run dev",
    "dev:fe:container": "pnpm --dir betamovie-fe run dev -- --host 0.0.0.0 --port 5173",
    "dev:be:container": "cd betamovie-be && node ./node_modules/nitropack/dist/cli/index.mjs dev --host 0.0.0.0 --port 3000",
    "dev:desktop": "pnpm --filter betamovie-desktop dev",
    "dev:all": "pnpm -r --parallel --stream --filter betamovie-fe --filter betamovie-be dev",
    "build": "pnpm run build:fe && pnpm run build:be",
    "build:fe": "pnpm --dir betamovie-fe run build",
    "build:be": "pnpm --dir betamovie-be run build",
    "build:desktop": "pnpm --dir betamovie-desktop run build",
    "build:desktop:all": "node scripts/build-desktop.js",
    "pack:desktop": "pnpm --dir betamovie-desktop run package:dir",
    "dist:desktop": "pnpm --dir betamovie-desktop run package:release",
    "dist:desktop:mac": "pnpm --dir betamovie-desktop run package:release:mac",
    "dist:desktop:mac:arm64": "pnpm --dir betamovie-desktop run package:release:mac:arm64",
    "dist:desktop:mac:x64": "pnpm --dir betamovie-desktop run package:release:mac:x64",
    "dist:desktop:mac:universal": "pnpm --dir betamovie-desktop run package:release:mac:universal",
    "preview:fe": "pnpm --dir betamovie-fe run preview",
    "preview:be": "pnpm --dir betamovie-be run preview",
    "lint": "pnpm run lint:fe && pnpm run lint:be",
    "lint:fe": "pnpm --dir betamovie-fe run lint",
    "lint:be": "pnpm --dir betamovie-be run lint",
    "prepare:be": "pnpm --dir betamovie-be run prepare",
    "preinstall": "npx -y only-allow pnpm"
  }
}
