{
  "name": "framezoo",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter framezoo-fe dev",
    "dev:fe": "pnpm --filter framezoo-fe dev",
    "dev:be": "pnpm --filter framezoo-be dev",
    "dev:desktop": "pnpm --filter framezoo-desktop dev",
    "dev:torrent": "pnpm --filter framezoo-desktop dev:torrent",
    "dev:all": "pnpm -r --parallel --stream --filter framezoo-fe --filter framezoo-be dev",
    "build": "pnpm run build:fe && pnpm run build:be",
    "build:fe": "pnpm --filter framezoo-fe build",
    "build:be": "pnpm --filter framezoo-be build",
    "build:desktop": "pnpm --filter framezoo-desktop build",
    "build:desktop:all": "node scripts/build-desktop.js",
    "pack:desktop": "pnpm --filter framezoo-desktop package:dir",
    "dist:desktop": "pnpm --filter framezoo-desktop package:release",
    "dist:desktop:mac": "pnpm --filter framezoo-desktop package:release:mac",
    "dist:desktop:mac:arm64": "pnpm --filter framezoo-desktop package:release:mac:arm64",
    "dist:desktop:mac:x64": "pnpm --filter framezoo-desktop package:release:mac:x64",
    "dist:desktop:mac:universal": "pnpm --filter framezoo-desktop package:release:mac:universal",
    "preview:fe": "pnpm --filter framezoo-fe preview",
    "preview:be": "pnpm --filter framezoo-be preview",
    "lint": "pnpm run lint:fe && pnpm run lint:be",
    "lint:fe": "pnpm --filter framezoo-fe lint",
    "lint:be": "pnpm --filter framezoo-be lint",
    "prepare:be": "pnpm --filter framezoo-be prepare",
    "preinstall": "npx -y only-allow pnpm"
  }
}
