{
  "name": "betamovie",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter betamovie-fe dev",
    "dev:fe": "pnpm --filter betamovie-fe dev",
    "dev:be": "pnpm --filter betamovie-be dev",
    "dev:desktop": "pnpm --filter betamovie-desktop dev",
    "dev:all": "pnpm -r --parallel --stream --filter betamovie-fe --filter betamovie-be dev",
    "build": "pnpm run build:fe && pnpm run build:be",
    "build:fe": "pnpm --filter betamovie-fe build",
    "build:be": "pnpm --filter betamovie-be build",
    "build:desktop": "pnpm --filter betamovie-desktop build",
    "pack:desktop": "pnpm --filter betamovie-desktop package:dir",
    "dist:desktop": "pnpm --filter betamovie-desktop package:release",
    "dist:desktop:mac": "pnpm --filter betamovie-desktop package:release:mac",
    "dist:desktop:mac:arm64": "pnpm --filter betamovie-desktop package:release:mac:arm64",
    "dist:desktop:mac:x64": "pnpm --filter betamovie-desktop package:release:mac:x64",
    "dist:desktop:mac:universal": "pnpm --filter betamovie-desktop package:release:mac:universal",
    "preview:fe": "pnpm --filter betamovie-fe preview",
    "preview:be": "pnpm --filter betamovie-be preview",
    "lint": "pnpm run lint:fe && pnpm run lint:be",
    "lint:fe": "pnpm --filter betamovie-fe lint",
    "lint:be": "pnpm --filter betamovie-be lint",
    "prepare:be": "pnpm --filter betamovie-be prepare",
    "preinstall": "npx -y only-allow pnpm"
  }
}
