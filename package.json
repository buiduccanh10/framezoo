{
  "name": "betamovie",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter betamovie-fe dev",
    "dev:fe": "pnpm --filter betamovie-fe dev",
    "dev:be": "pnpm --filter betamovie-be dev",
    "dev:all": "pnpm -r --parallel --stream --filter betamovie-fe --filter betamovie-be dev",
    "build": "pnpm run build:fe && pnpm run build:be",
    "build:fe": "pnpm --filter betamovie-fe build",
    "build:be": "pnpm --filter betamovie-be build",
    "preview:fe": "pnpm --filter betamovie-fe preview",
    "preview:be": "pnpm --filter betamovie-be preview",
    "lint": "pnpm run lint:fe && pnpm run lint:be",
    "lint:fe": "pnpm --filter betamovie-fe lint",
    "lint:be": "pnpm --filter betamovie-be lint",
    "prepare:be": "pnpm --filter betamovie-be prepare",
    "preinstall": "npx -y only-allow pnpm"
  }
}
